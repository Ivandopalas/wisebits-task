# Copy to .env to override the defaults used by docker compose and local development.

# --- docker compose ---
APP_PORT=8080
# Published on 127.0.0.1 only by `pnpm db:up`, for local development.
MONGO_PORT=27017
# Any random string of 32+ characters, e.g. `openssl rand -hex 32`.
JWT_SECRET=local-demo-secret-change-me-for-anything-real
# true whenever the app is served over https.
COOKIE_SECURE=false
AUTH_RATE_LIMIT_PER_MINUTE=30
LOG_LEVEL=info

# --- local development (pnpm dev) ---
# Mongo from `pnpm db:up`; directConnection lets the host reach the replica set
# member that advertises itself as mongo:27017 inside the Docker network.
MONGO_URI=mongodb://localhost:27017/chat?directConnection=true
NODE_ENV=development
PORT=3000
